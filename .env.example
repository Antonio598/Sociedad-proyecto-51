# Variables de entorno de la app. En EasyPanel van en la pestaña «Environment» del servicio.
# Este archivo es sólo la lista: NO pongas valores reales aquí.

# ── Base de datos (Supabase) ──────────────────────────────────────────────────
# Supabase → Connect → «Session pooler» (puerto 5432). Cambia `postgresql://` por
# `postgresql+psycopg://` al principio: así SQLAlchemy usa el driver instalado.
DATABASE_URL=postgresql+psycopg://postgres.TU_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# ── Firma de las sesiones ─────────────────────────────────────────────────────
# Genera una nueva con:  openssl rand -base64 48
# Si cambia, se cierran todas las sesiones Y las claves guardadas de operadores dejan de
# poder mostrarse (se pueden restablecer). Usa la MISMA que tenía el servidor anterior.
SESSION_SECRET=

# ── Administrador inicial (sólo si la base está vacía) ───────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=

# ── IA ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── Mapas ─────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_API_KEY=

# ── Obligatoria aunque el bot de WhatsApp esté retirado ──────────────────────
EVOLUTION_APIKEY=sin-uso

# ── Contacto del coordinador (WhatsApp, sólo dígitos: 5218112345678) ─────────
COORDINADOR_NOMBRE=Coordinación
COORDINADOR_WHATSAPP=

# ── Zona horaria ──────────────────────────────────────────────────────────────
TZ=America/Monterrey
ZONA_HORARIA=America/Monterrey
