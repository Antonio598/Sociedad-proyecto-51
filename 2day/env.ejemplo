# Copia este archivo a `.env` DENTRO DEL SERVIDOR y rellénalo.
#
#     cp env.ejemplo .env && nano .env
#
# El `.env` NO viaja en ningún repositorio ni se comparte por chat: lleva la contraseña de la
# base, la clave de Anthropic y las de Maps.

# ── La base de datos ──────────────────────────────────────────────────────────
# `postgres` es el NOMBRE DEL SERVICIO del docker-compose, no «localhost»: dentro de la red de
# Docker cada contenedor se llama por su nombre. Poner localhost aquí es el error clásico —
# la app se buscaría a sí misma.
POSTGRES_PASSWORD=PON-UNA-CONTRASEÑA-LARGA-AQUI
DATABASE_URL=postgresql+psycopg://evolution:PON-LA-MISMA-DE-ARRIBA@postgres:5432/combustible

# ── La firma de las sesiones ──────────────────────────────────────────────────
# Si está vacía o se repite entre entornos, las sesiones se pueden falsificar. Genera una
# nueva EN EL SERVIDOR con:
#     openssl rand -base64 48
SESSION_SECRET=PEGA-AQUI-LO-QUE-DEVUELVA-openssl

# ── El administrador inicial ──────────────────────────────────────────────────
# Sólo se usa la PRIMERA vez, cuando la base está vacía: después, cambiar esto no cambia la
# cuenta que ya existe. Si traes la base de tu máquina, tus usuarios vienen con ella y esto
# se ignora.
ADMIN_USER=admin
ADMIN_PASSWORD=PON-UNA-CONTRASEÑA-NUEVA-PARA-PRODUCCION

# ── La IA ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── Mapas ─────────────────────────────────────────────────────────────────────
# La de navegador va restringida por dominio: acuérdate de AÑADIR el dominio nuevo en la
# consola de Google, o las rutas dejarán de dibujarse.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_API_KEY=

# ── Obligatoria aunque ya no se use ───────────────────────────────────────────
# El bot de WhatsApp está retirado, pero `config.py` sigue exigiendo esta variable y sin ella
# la app no arranca. Cualquier texto vale.
EVOLUTION_APIKEY=sin-uso

# ── Contacto del coordinador ──────────────────────────────────────────────────
# El operador lo usa para pedir ayuda desde su teléfono. Vacío = el botón no lleva a ningún
# sitio. Formato internacional, sin signos: 5218112345678
COORDINADOR_NOMBRE=Coordinación
COORDINADOR_WHATSAPP=

# ── Zona horaria ──────────────────────────────────────────────────────────────
TZ=America/Monterrey
